#!name=TSXY 资源查看器
#!desc=从列表提取媒体地址；详情因未订阅被拒绝时，经 HEAD 校验后改写为播放器所需的成功响应。
#!system=ios
#!author=AnLingzhi
#!homepage=https://github.com/AnLingzhi/Surge
#!category=工具

[Script]
TSXY 资源查看器 = type=http-response, pattern=^https:\/\/api\.tsxyapp\.com\/api\/(?:course(?:\/list(?:\/latest)?)?|livefile(?:\/latest|\/month\/items)?)\?, requires-body=true, max-size=1048576, timeout=10, script-path=https://raw.githubusercontent.com/AnLingzhi/Surge/refs/heads/main/tsxy-resource-viewer.js?v=2

[MITM]
hostname = %APPEND% api.tsxyapp.com
