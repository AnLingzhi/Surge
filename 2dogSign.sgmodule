#!name= SignIn: 2dog
#!desc=二狗签到
#!author=AnLingzhi
#!homepage=https://github.com/AnLingzhi
#!category=签到
#!arguments=cron:0 0 * * *
#!arguments-desc=cron: 定时

# Credit
# @AnLingzhi, https://github.com/AnLingzhi/Script

[Script]
2dogCookie = type=http-request,pattern=https:\/\/mini\.tuodan\.tech\/jstd-doger\/app\/account\/v1\/getAccountInfo,requires-body=1,max-size=0,script-path=https://github.com/AnLingzhi/Surge/raw/main/2dogCookie.js
2dogUserInfo1 = type=http-response,pattern=https:\/\/mini\.tuodan\.tech\/jstd-doger\/app\/index\/v1\/page,requires-body=1,max-size=0,script-path=https://github.com/AnLingzhi/Surge/raw/main/2dogUserInfo.js
2dogUserInfo2 = type=http-response,pattern=https:\/\/mini\.tuodan\.tech\/jstd-doger\/app\/user\/v3\/singleSquare,requires-body=1,max-size=0,script-path=https://github.com/AnLingzhi/Surge/raw/main/2dogUserInfo.js
2dogSign = type=cron,cronexp={{{cron}}},script-path=https://github.com/AnLingzhi/Surge/raw/main/2dogSign.js
2dogPageList = type=http-response,pattern=https:\/\/mini\.tuodan\.tech\/jstd-doger\/app\/index\/v1\/pageList,requires-body=1,max-size=0,script-path=https://github.com/AnLingzhi/Surge/raw/main/2dogPageList.js

[MITM]
hostname = %APPEND% mini.tuodan.tech



