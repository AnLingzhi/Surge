{
  "id": "2dog.app.sub",
  "name": "二狗签到应用",
  "author": "@AnLingzhi",
  "icon": "https://raw.githubusercontent.com/AnLingzhi/Surge/main/2dog.png",
  "repo": "https://github.com/AnLingzhi/Surge",
  "apps": [
    {
      "id": "2dog",
      "name": "二狗签到",
      "keys": ["chavy_tokenurl_2dog", "chavy_tokenheader_2dog", "chavy_signurl_2dog", "chavy_signheader_2dog", "2dog_users"],
      "settings": [
        {
          "id": "2dog_users",
          "name": "用户列表",
          "val": "[]",
          "type": "cell",
          "desc": "存储的用户信息列表",
          "cell": {
            "type": "list",
            "props": {
              "allowDel": true,
              "style": {
                "padding": "8px 16px"
              }
            },
            "items": []
          }
        }
      ],
      "scripts": [
        {
          "name": "删除用户",
          "script": "const users = JSON.parse($persistentStore.read('2dog_users') || '[]'); const uid = $input.uid; const newUsers = users.filter(u => u.uid !== uid); $persistentStore.write(JSON.stringify(newUsers), '2dog_users'); $done();"
        }
      ],
      "author": "@AnLingzhi",
      "repo": "https://github.com/AnLingzhi/Surge",
      "icons": ["https://raw.githubusercontent.com/AnLingzhi/Surge/main/2dog.png"]
    }
  ]
} 